// GKD订阅 / GKD规则 / GKD第三方订阅 / MarsGao薅羊毛领券
// 拼多多领券、百亿补贴打卡、无门槛券、自动签到（非广告拦截大全）
// 格式：https://gkd.li/guide/subscription
// 导入：https://raw.githubusercontent.com/MarsGao/GkAndroidLabGKDCoupon/main/dist/gkd.json5
{
  id: 82640113,
  name: 'MarsGao薅羊毛领券',
  version: 4,
  author: 'MarsGao',
  updateUrl: 'https://raw.githubusercontent.com/MarsGao/GkAndroidLabGKDCoupon/main/dist/gkd.json5',
  checkUpdateUrl: 'https://raw.githubusercontent.com/MarsGao/GkAndroidLabGKDCoupon/main/dist/gkd.version.json5',
  supportUri: 'https://github.com/MarsGao/GkAndroidLabGKDCoupon',
  categories: [
    { key: 0, name: '领券签到' },
    { key: 1, name: '弹窗处理' },
  ],
  globalGroups: [],
  apps: [
    {
      id: 'com.xunmeng.pinduoduo',
      name: '拼多多',
      groups: [
        {
          key: 1,
          name: '领券签到-百亿补贴会员每日打卡',
          desc: '在「百亿补贴会员」页精确点击文案「打卡」。每天最多点 1 次，不含「打卡送积分」「待打卡」等标题文案。',
          enable: true,
          fastQuery: true,
          actionMaximum: 1,
          resetMatch: 'app',
          matchTime: 10000,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              matches: '[text="打卡"][visibleToUser=true]',
              exampleUrls: [],
              snapshotUrls: [],
            },
          ],
        },
        {
          key: 2,
          name: '领券签到-会员等级礼包无门槛券领取',
          desc: '在「百亿补贴会员等级」页，领取等级礼包中的无门槛券。不点「去使用/已使用」，不点「少拉1人」裂变卡，不进商品页。',
          enable: true,
          fastQuery: true,
          actionMaximum: 2,
          resetMatch: 'app',
          matchTime: 15000,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              name: '无门槛券旁领取',
              // 同屏出现「无门槛券」文案后，点「领取」；已领时文案变「去使用」，规则自然失效
              matches: [
                '[text*="无门槛券"][visibleToUser=true]',
                '[text="领取"][visibleToUser=true]',
              ],
              snapshotUrls: [],
            },
            {
              key: 1,
              name: '等级礼包区块内领取（兜底）',
              matches: [
                '[text*="等级礼包"][visibleToUser=true]',
                '[text="领取"][visibleToUser=true]',
              ],
              snapshotUrls: [],
            },
          ],
        },
        {
          key: 3,
          name: '弹窗处理-关闭诱导弹窗',
          desc: '关闭「残忍拒绝/以后再说/我知道了/开心收下」等干扰弹窗；不点分享裂变。',
          enable: true,
          fastQuery: true,
          actionMaximum: 5,
          rules: [
            {
              key: 0,
              matches: '[text="残忍拒绝" || text="以后再说" || text="我知道了" || text="开心收下"][visibleToUser=true]',
            },
            {
              key: 1,
              matches: 'ImageView[desc="关闭" || desc="close"][visibleToUser=true]',
            },
          ],
        },
        {
          key: 4,
          name: '领券签到-进入百亿消费券会场',
          desc: '主会场「百亿消费券/…待领」入口。注意：多数机型上该 H5 横滑卡无障碍树为空，GKD 可能点不到；请用 scripts/enter_coupon_venue.py（ADB）进场，进场后由规则5自动领。',
          enable: true,
          fastQuery: true,
          actionMaximum: 1,
          resetMatch: 'app',
          matchTime: 20000,
          actionDelay: 300,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              name: '同节点含百亿消费券+待领',
              matches: '[text*="百亿消费券"][text*="待领"][visibleToUser=true]',
            },
            {
              key: 1,
              name: '拆分节点：先见百亿消费券，再点待领',
              // 文案常拆成两个 TextView；数组匹配点最后一个
              matches: [
                '[text*="百亿消费券"][visibleToUser=true]',
                '[text*="待领"][visibleToUser=true]',
              ],
            },
            {
              key: 2,
              name: '短文案 / desc 兜底',
              matches: '[text*="百亿消费券" || desc*="百亿消费券" || text*="100元券待领"][visibleToUser=true]',
            },
          ],
        },
        {
          key: 5,
          name: '领券签到-百亿消费券会场立即领取',
          desc: '已进入「消费券」会场（有双重补贴/地区专享）后，自动点「立即领取/一键全领/开心收下/立即点亮」。已领后变「去使用」则不再点。不点抽福袋。真机已验证三券领取→去使用。',
          enable: true,
          fastQuery: true,
          actionMaximum: 20,
          matchTime: 25000,
          actionDelay: 400,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              name: '会场内立即领取',
              matches: [
                '[text="消费券" || text*="双重补贴" || text*="地区专享" || text*="共"][visibleToUser=true]',
                '[text="立即领取" || text="一键全领" || text="开心收下" || text="立即点亮"][visibleToUser=true]',
              ],
            },
          ],
        },
      ],
    },
  ],
}
