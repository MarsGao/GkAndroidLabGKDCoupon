// v6：收窄卡片关系；未经验证的入口/点亮/切 Tab 默认关闭（脚本任务模式主基线）
{
  id: 82640113,
  name: 'MarsGao薅羊毛领券',
  version: 6,
  author: 'MarsGao',
  updateUrl: 'https://raw.githubusercontent.com/MarsGao/GkAndroidLabGKDCoupon/main/dist/gkd.json5',
  checkUpdateUrl: 'https://raw.githubusercontent.com/MarsGao/GkAndroidLabGKDCoupon/main/dist/gkd.version.json5',
  supportUri: 'https://github.com/MarsGao/GkAndroidLabGKDCoupon',
  categories: [
    { key: 0, name: '领券签到' },
    { key: 1, name: '弹窗处理' },
  ],
  globalGroups: [],
  apps: [
    {
      id: 'com.xunmeng.pinduoduo',
      name: '拼多多',
      groups: [
        {
          key: 1,
          name: '领券签到-百亿补贴会员每日打卡',
          desc: '精确点击 text=「打卡」。不含「打卡送积分」「待打卡」。resetMatch=app 表示重进 App 重置次数，不是自然日限额。',
          enable: true,
          fastQuery: true,
          actionMaximum: 1,
          resetMatch: 'app',
          matchTime: 10000,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              matches: '[text="打卡"][visibleToUser=true]',
              snapshotUrls: [],
            },
          ],
        },
        {
          key: 2,
          name: '领券签到-会员等级礼包无门槛券领取',
          desc: '同一卡片祖先内：无门槛券 + 领取。不点去使用/已使用/少拉1人。',
          enable: true,
          fastQuery: true,
          actionMaximum: 2,
          resetMatch: 'app',
          matchTime: 15000,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              name: '无门槛券同卡领取',
              // @ 标记点击目标；<(1,6) 上溯共同祖先后再找同卡「无门槛券」
              matches:
                '@[text="领取"][visibleToUser=true] <(1,6) [childCount>1] >(1,10) [text*="无门槛券"][visibleToUser=true]',
              snapshotUrls: [],
            },
          ],
        },
        {
          key: 3,
          name: '弹窗处理-关闭已知诱导弹窗',
          desc: '仅关闭已识别文案；不含开心收下/去使用/继续（避免误关业务或误点领取）。',
          enable: true,
          fastQuery: true,
          actionMaximum: 5,
          rules: [
            {
              key: 0,
              matches:
                '[text="残忍拒绝" || text="以后再说" || text="我知道了" || text="朕知道了"][visibleToUser=true]',
            },
            {
              key: 1,
              matches: 'ImageView[desc="关闭" || desc="close"][visibleToUser=true]',
            },
          ],
        },
        {
          key: 4,
          name: '领券签到-进入百亿消费券会场',
          desc: '主会场入口 H5 常无障碍空树；默认关闭。进场请用 scripts/enter_coupon_venue.py（脚本任务模式）。',
          enable: false,
          fastQuery: true,
          actionMaximum: 1,
          resetMatch: 'app',
          matchTime: 20000,
          actionDelay: 300,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              name: '同节点含百亿消费券+待领',
              matches: '[text*="百亿消费券"][text*="待领"][visibleToUser=true]',
            },
          ],
        },
        {
          key: 5,
          name: '领券签到-消费券会场立即领取',
          desc: '会场锚点 + 立即领取；已去掉模糊金额兜底与通用收下类关闭。仍须 GKD 引擎真机验收；脚本模式请先停用本规则。',
          enable: true,
          fastQuery: true,
          actionMaximum: 20,
          matchTime: 30000,
          actionDelay: 500,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              name: '会场锚点下的立即领取',
              matches: [
                '[text="消费券" || text="双重补贴" || text="地区专享"][visibleToUser=true]',
                '[text="立即领取"][visibleToUser=true]',
              ],
            },
          ],
        },
        {
          key: 6,
          name: '领券签到-消费券会场立即点亮',
          desc: '未经验证默认关闭；点亮+浏览计时由脚本状态机负责。不含无前置条件的「去看看」。',
          enable: false,
          fastQuery: true,
          actionMaximum: 1,
          resetMatch: 'app',
          matchTime: 15000,
          actionDelay: 300,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              matches: '[text="立即点亮"][visibleToUser=true]',
            },
          ],
        },
        {
          key: 7,
          name: '领券签到-切换地区专享',
          desc: '未经验证默认关闭；切 Tab 由 scripts/claim_region_exclusive.py 负责并核验。',
          enable: false,
          fastQuery: true,
          actionMaximum: 2,
          resetMatch: 'app',
          matchTime: 20000,
          actionDelay: 400,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              matches: [
                '[text="消费券" || text*="百亿消费券"][visibleToUser=true]',
                '[text="地区专享"][visibleToUser=true]',
              ],
            },
          ],
        },
      ],
    },
  ],
}
