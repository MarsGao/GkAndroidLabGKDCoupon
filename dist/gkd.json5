// GKD订阅 / MarsGao薅羊毛领券
// 唯一发布源：本文件 + gkd.version.json5（勿回灌 Lab configs/gkd）
// 导入：https://raw.githubusercontent.com/MarsGao/GkAndroidLabGKDCoupon/main/dist/gkd.json5
// v7：key8 会场有序流水线（order + excludeMatches）；key5 默认关避免与 key8 抢点
// 说明：GKD 可弱约束同页先后，不能可靠完成「领完→点亮→浏览计时→核验」；完整闭环用 scripts/run_venue_pipeline.py
{
  id: 82640113,
  name: 'MarsGao薅羊毛领券',
  version: 7,
  author: 'MarsGao',
  updateUrl: 'https://raw.githubusercontent.com/MarsGao/GkAndroidLabGKDCoupon/main/dist/gkd.json5',
  checkUpdateUrl: 'https://raw.githubusercontent.com/MarsGao/GkAndroidLabGKDCoupon/main/dist/gkd.version.json5',
  supportUri: 'https://github.com/MarsGao/GkAndroidLabGKDCoupon',
  categories: [
    { key: 0, name: '领券签到' },
    { key: 1, name: '弹窗处理' },
  ],
  globalGroups: [],
  apps: [
    {
      id: 'com.xunmeng.pinduoduo',
      name: '拼多多',
      groups: [
        {
          key: 1,
          name: '领券签到-百亿补贴会员每日打卡',
          desc: '精确点击 text=「打卡」。不含「打卡送积分」「待打卡」。resetMatch=app 表示重进 App 重置次数，不是自然日限额。',
          enable: true,
          fastQuery: true,
          actionMaximum: 1,
          resetMatch: 'app',
          matchTime: 10000,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              matches: '[text="打卡"][visibleToUser=true]',
              snapshotUrls: [],
            },
          ],
        },
        {
          key: 2,
          name: '领券签到-会员等级礼包无门槛券领取',
          desc: '同一卡片祖先内：无门槛券 + 领取。不点去使用/已使用/少拉1人。',
          enable: true,
          fastQuery: true,
          actionMaximum: 2,
          resetMatch: 'app',
          matchTime: 15000,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              name: '无门槛券同卡领取',
              matches:
                '@[text="领取"][visibleToUser=true] <(1,6) [childCount>1] >(1,10) [text*="无门槛券"][visibleToUser=true]',
              snapshotUrls: [],
            },
          ],
        },
        {
          key: 3,
          name: '弹窗处理-关闭已知诱导弹窗',
          desc: '仅关闭已识别文案；不含开心收下/去使用/继续（避免误关业务或误点领取）。',
          enable: true,
          fastQuery: true,
          actionMaximum: 5,
          rules: [
            {
              key: 0,
              matches:
                '[text="残忍拒绝" || text="以后再说" || text="我知道了" || text="朕知道了"][visibleToUser=true]',
            },
            {
              key: 1,
              matches: 'ImageView[desc="关闭" || desc="close"][visibleToUser=true]',
            },
          ],
        },
        {
          key: 4,
          name: '领券签到-进入百亿消费券会场',
          desc: '主会场入口 H5 常无障碍空树；默认关闭。进场请用 scripts/enter_coupon_venue.py（脚本任务模式）。',
          enable: false,
          fastQuery: true,
          actionMaximum: 1,
          resetMatch: 'app',
          matchTime: 20000,
          actionDelay: 300,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              name: '同节点含百亿消费券+待领',
              matches: '[text*="百亿消费券"][text*="待领"][visibleToUser=true]',
            },
          ],
        },
        {
          key: 5,
          name: '领券签到-消费券会场立即领取（单规则·遗留）',
          desc: 'v7 起默认关闭；请用 key8 有序流水线。脚本模式务必关闭 key5/key8。',
          enable: false,
          fastQuery: true,
          actionMaximum: 20,
          matchTime: 30000,
          actionDelay: 500,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              name: '会场锚点下的立即领取',
              matches: [
                '[text="消费券" || text="双重补贴" || text="地区专享"][visibleToUser=true]',
                '[text="立即领取"][visibleToUser=true]',
              ],
            },
          ],
        },
        {
          key: 6,
          name: '领券签到-消费券会场立即点亮（单规则·遗留）',
          desc: '默认关闭；无 excludeMatches 时会与领取抢点。请用 key8 或脚本。',
          enable: false,
          fastQuery: true,
          actionMaximum: 1,
          resetMatch: 'app',
          matchTime: 15000,
          actionDelay: 300,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              matches: '[text="立即点亮" || text="解锁点亮"][visibleToUser=true]',
            },
          ],
        },
        {
          key: 7,
          name: '领券签到-切换地区专享（单规则·遗留）',
          desc: '默认关闭；切 Tab 已并入 key8，脚本模式仍以 claim_region_exclusive 核验为准。',
          enable: false,
          fastQuery: true,
          actionMaximum: 2,
          resetMatch: 'app',
          matchTime: 20000,
          actionDelay: 400,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              matches: [
                '[text="消费券" || text*="百亿消费券"][visibleToUser=true]',
                '[text="地区专享"][visibleToUser=true]',
              ],
            },
          ],
        },
        {
          key: 8,
          name: '领券签到-会场有序流水线（先领后点亮）',
          desc: '同组内 order 越小越优先匹配。点亮规则用 excludeMatches 挡住仍存在的「立即领取」。preKeys 只表示「刚执行过某规则」，不能表达「领完」。不含 10s 浏览核验——完整闭环用 scripts/run_venue_pipeline.py。脚本任务模式请关闭本组。',
          enable: true,
          fastQuery: true,
          matchTime: 45000,
          actionDelay: 450,
          activityIds: [
            'com.xunmeng.pinduoduo.activity.NewPageActivity',
            'com.xunmeng.pinduoduo.activity.NewPageMaskActivity',
          ],
          rules: [
            {
              key: 0,
              name: '切换地区专享',
              order: 10,
              actionMaximum: 2,
              resetMatch: 'app',
              matches: [
                '[text="消费券" || text*="百亿消费券" || text="双重补贴"][visibleToUser=true]',
                '[text="地区专享"][visibleToUser=true]',
              ],
            },
            {
              key: 1,
              name: '地区/会场立即领取',
              order: 20,
              actionMaximum: 20,
              matches: [
                '[text="消费券" || text="双重补贴" || text="地区专享"][visibleToUser=true]',
                '[text="立即领取"][visibleToUser=true]',
              ],
            },
            {
              key: 2,
              name: '点亮（屏幕无立即领取时）',
              order: 30,
              actionMaximum: 1,
              resetMatch: 'app',
              // 同屏仍有可领券时禁止点亮 —— 这是 GKD 能做的「先后」约束上限
              excludeMatches: ['[text="立即领取"][visibleToUser=true]'],
              matches: '[text="立即点亮" || text="解锁点亮"][visibleToUser=true]',
            },
          ],
        },
      ],
    },
  ],
}
